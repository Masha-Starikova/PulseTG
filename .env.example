# Скопируйте в .env и заполните: cp .env.example .env
# Файл .env в git не попадает. Настоящие значения сюда не записывайте.
# Переменные без значения обязательны: Docker Compose и приложение их читают.
# Закомментированные переменные необязательны, значения по умолчанию заданы в backend/core/config.py.

# ---------- PostgreSQL ----------
# Имя базы, пользователь и пароль для контейнера postgres.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
# Адрес для приложения. Хост внутри Docker: postgres.
# Формат: postgresql+asyncpg://<пользователь>:<пароль>@postgres:5432/<база>
DATABASE_URL=

# ---------- Redis и Celery ----------
# Хост внутри Docker: redis. Для разных задач используются разные номера баз.
# Формат: redis://redis:6379/0
REDIS_URL=
# Формат: redis://redis:6379/1
CELERY_BROKER_URL=
# Формат: redis://redis:6379/2
CELERY_RESULT_BACKEND=

# ---------- Telegram ----------
# Целое число и строка с https://my.telegram.org. Без них аудит завершится ошибкой.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Имя session-файла без расширения. Файл лежит в backend/telegram/.
TELEGRAM_SESSION_NAME=

# ---------- OpenAI ----------
# Без ключа аудит завершится статусом failed с понятным сообщением.
OPENAI_API_KEY=
# OPENAI_MODEL=
# OPENAI_TIMEOUT_SECONDS=

# ---------- Приложение ----------
# APP_NAME=
# APP_ENV=
# APP_HOST=
# APP_PORT=
# DEBUG=
